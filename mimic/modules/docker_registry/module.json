{
    "kind": "manifest",
    "title": "Docker Registry (v2 API)",
    "description": "Stub registry API for /v2 with configurable catalog, manifests, tags, and blobs.",
    "default_enabled": false,
    "default_prefix": "/v2/",
    "max_concurrent": 4,
    "strict_slashes": true,
    "default_methods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "OPTIONS",
        "HEAD"
    ],
    "default_response": {
        "passthrough": false,
        "headers": {
            "Content-Type": "application/json"
        },
        "status": 200,
        "body": {}
