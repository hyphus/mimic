                    "passthrough": false,
                    "response": {
                        "status": 200,
                        "headers": {
                            "Content-Type": "application/json",
                            "Docker-Distribution-Api-Version": "registry/2.0"
                        },
                        "body": {}
                    }
                }
            ]
